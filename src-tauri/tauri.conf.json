{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "마이두 뷰어",
  "version": "0.1.0",
  "identifier": "com.mydoo.viewer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "마이두 뷰어",
        "width": 1000,
        "height": 720,
        "minWidth": 480,
        "minHeight": 360,
        "decorations": true,
        "transparent": false,
        "fullscreen": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "마이두 패밀리의 가벼운 문서 뷰어",
    "longDescription": "Markdown / HTML / Text 파일을 깃 스타일로 한 창에 띄우는 가벼운 뷰어. 좌측 사이드바에서 폴더를 열어 .md / .html / .txt 파일만 트리로 본다.",
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "html", "htm", "txt"],
        "name": "Mydoo Viewer Document",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"]
      }
    }
  },
  "plugins": {}
}
